# ==============================================================================
# SmartCart AI - Environment Configuration Template
# DO NOT store real production secrets or credentials in this file or repository.
# Copy this file to '.env' and fill in your actual local configuration.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
APP_NAME="SmartCart AI"
API_V1_STR="/api/v1"
SECRET_KEY=change_this_to_a_secure_random_64_char_string_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Settings
# Local development default: SQLite
DATABASE_URL=sqlite:///./smartcart.db
# Production Neon PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Protected Admin Bootstrapping (Out-of-band CLI or initial boot check only)
# Used exclusively by 'python -m app.scripts.create_admin' if env args are omitted
ADMIN_INITIAL_EMAIL=admin@smartcart.local
ADMIN_INITIAL_PASSWORD=ChangeMeAdmin123!
ADMIN_INITIAL_NAME="System Administrator"

# PayPal Sandbox Configuration (Server-Side Only)
# Get credentials from developer.paypal.com sandbox account
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=sandbox_client_id_placeholder
PAYPAL_CLIENT_SECRET=sandbox_client_secret_placeholder
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=INR
PAYPAL_WEBHOOK_ID=sandbox_webhook_id_placeholder

# Currency settings
CURRENCY=INR
